# LANStream Portal — Environment Variables
# Copy this file to .env.local and fill in the values.
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 48

# Database (port must match compose.dev.yaml POSTGRES_PORT)
DATABASE_URL=postgresql://lanstream:lanstream_dev@localhost:5432/lanstream

# Auth
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-48>
BETTER_AUTH_URL=http://localhost:3000

# App
NODE_ENV=development
PORTAL_URL=http://localhost:3000
