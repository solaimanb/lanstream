# LANStream — Environment Variables
# Copy this file to .env and fill in the values.

# Database
DATABASE_URL=postgres://lanstream:lanstream_dev@localhost:5432/lanstream

# Better Auth (generate with: openssl rand -base64 48)
BETTER_AUTH_SECRET=change-me-in-production-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Portal
PORTAL_URL=http://localhost:3000
NODE_ENV=development

# LAN Host agent (pair once from Portal → Host Machines)
LANSTREAM_PORTAL_URL=http://localhost:3000
# Optional recovery/automation override. Normal installs pair in the browser and
# persist their credential automatically.
LANSTREAM_AGENT_TOKEN=

# ── Production additions ──
# DATABASE_PASSWORD=<strong-password-for-postgres>
# NODE_ENV=production
